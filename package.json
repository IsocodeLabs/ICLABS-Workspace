{
  "name": "iclabs-workspace",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@iclabs/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @iclabs/db generate",
    "db:migrate": "pnpm --filter @iclabs/db migrate",
    "db:seed": "pnpm --filter @iclabs/web seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "prettier": "^3.9.10",
    "turbo": "2.11.8"
  }
}
