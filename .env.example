# Copy to apps/web/.env.local for local development. Never commit real values.

# Local Postgres from docker compose
DATABASE_URL=postgres://iclabs:iclabs@localhost:5432/iclabs

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud console → APIs & Services → Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TEAM_EMAIL_DOMAIN=isocodelabs.com

# Used by `pnpm db:seed`
SEED_ADMIN_EMAIL=you@isocodelabs.com

# Email. Local: EMAIL_TRANSPORT=smtp with SMTP_URL=smtp://localhost:1025 (MailPit), or "log".
EMAIL_TRANSPORT=log
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Isocode Hiring <hiring@mail.isocodelabs.com>
EMAIL_REPLY_TO=hiring@isocodelabs.com
# Non-production: only these addresses/@domains get real email; others go to the SES simulator.
EMAIL_ALLOWLIST=@isocodelabs.com
# openssl rand -base64 32
EMAIL_PAYLOAD_KEY=
# openssl rand -hex 32
CRON_SECRET=
SNS_TOPIC_ARN=

# Candidate files. Production: STORAGE_DRIVER=gcs, GCS_BUCKET=<private bucket>, SCAN_MODE=clamav.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=.uploads
SCAN_MODE=none
