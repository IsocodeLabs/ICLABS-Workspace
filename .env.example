# Copy to apps/web/.env.local for local development. Never commit real values.

# Local Postgres from docker compose
DATABASE_URL=postgres://iclabs:iclabs@localhost:5432/iclabs

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud console → APIs & Services → Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TEAM_EMAIL_DOMAIN=isocodelabs.com

# Used by `pnpm db:seed`
SEED_ADMIN_EMAIL=you@isocodelabs.com
